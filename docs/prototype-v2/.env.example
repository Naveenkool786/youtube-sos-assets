# ===== Supabase =====
# Get from Supabase Dashboard → Settings → API

# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Anthropic Claude API =====
# Get from https://console.anthropic.com → API Keys
# Server-side only
ANTHROPIC_API_KEY=sk-ant-your-key

# ===== App config =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Weftly

# ===== Optional (Phase 3+) =====
# Email provider (Resend) — needed for custom auth emails and NCR notifications
# RESEND_API_KEY=

# Error monitoring
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Analytics (Vercel Analytics is free + auto-enabled when deployed)
